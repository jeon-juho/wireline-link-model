# --- Python virtual environment -------------------------------------------
.venv/
venv/
env/
ENV/

# --- Python bytecode and caches -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Test / type / lint caches --------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Generated simulation output -------------------------------------------
# Everything in results/ is reproducible by re-running the scripts, and the
# plots change on every run, so they are not tracked.  The directory itself is
# kept via .gitkeep.  Delete these three lines if you want figures in the repo.
results/*
!results/.gitkeep

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Local scratch ---------------------------------------------------------
scratch/
tmp/
*.tmp

# --- Channel data ----------------------------------------------------------
# The IEEE 802.3ck S-parameters are ~37 MB and belong to the P802.3ck task
# force, so they are downloaded rather than redistributed here.
# channel/README.md has the link and the expected layout.
channel/*
!channel/README.md
